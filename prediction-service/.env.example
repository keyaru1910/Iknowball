# Cổng chạy FastAPI
PORT=8000

# Database (nếu prediction-service cần đọc dữ liệu trận đấu trực tiếp)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iknowball

# Nguồn dữ liệu thể thao bên ngoài (API-Football, SportRadar, v.v. — tuỳ bạn chọn ở Phase 3)
SPORTS_DATA_API_KEY=your_sports_data_api_key

# Môi trường
ENVIRONMENT=development