# ==============================================================================
# iKnowBall Frontend Environment Configuration Template
# ==============================================================================

# Địa chỉ API Backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Khóa công khai Stripe (dành cho Stripe Elements / Checkout redirect trên Client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Google OAuth Client ID cho nút đăng nhập phía client
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Môi trường chạy ứng dụng
NEXT_PUBLIC_ENV=development

# Địa chỉ URL của Frontend App
NEXT_PUBLIC_APP_URL=http://localhost:3000