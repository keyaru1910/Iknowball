// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  passwordHash    String?
  fullName        String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  roleId          String
  role            Role                 @relation(fields: [roleId], references: [id])
  status          String               @default("active") // active | banned
  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]
  resetTokens     PasswordResetToken[]
  predictionViews PredictionView[]
  subscriptions   Subscription[]
  payments        Payment[]
  notifications   Notification[]
  comments        Comment[]
  commentReports  CommentReport[] @relation("CommentReporter")
  targetAuditLogs AuditLog[]           @relation("TargetUser")
  actorAuditLogs  AuditLog[]           @relation("ActorUser")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String @id @default(uuid())
  name        String @unique // guest | user | premium | admin
  permissions Json?
  users       User[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([tokenHash])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String // "google"
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
}

// ===== Sports Domain (Phase 3) =====

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELED
}

enum SyncJobStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum NewsSport {
  FOOTBALL
  BASKETBALL
}
enum CommentableType {
  NEWS_ARTICLE
  MATCH
  PREDICTION
}
enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

model NewsArticle {
  id           String    @id @default(uuid())
  slug         String    @unique
  sport        NewsSport
  category     String?
  sourceName   String
  sourceUrl    String    @unique
  title        String
  excerpt      String?
  imageUrl     String?
  publishedAt  DateTime?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([sport, category, publishedAt])
}

model Comment {
  id         String          @id @default(uuid())
  content    String          @db.VarChar(2000)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType CommentableType
  entityId   String
  parentId   String?
  parent     Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[]       @relation("CommentReplies")
  depth      Int             @default(0)
  status     CommentStatus   @default(VISIBLE)
  isEdited   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  reports    CommentReport[]
  @@index([entityType, entityId, status, createdAt])
  @@index([parentId])
}

model CommentReport {
  id         String   @id @default(uuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("CommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  @@unique([commentId, reporterId])
}

enum PredictionOutcome {
  HOME_WIN
  DRAW
  AWAY_WIN
}

model Sport {
  id      String   @id @default(uuid())
  name    String   @unique // "football" | "basketball"
  leagues League[]

  createdAt DateTime @default(now())
}

model League {
  id          String  @id @default(uuid())
  sportId     String
  sport       Sport   @relation(fields: [sportId], references: [id])
  name        String
  country     String?
  logoUrl     String?
  externalId  String  @unique
  season      String
  contentHash String? @db.VarChar(64)

  teams     Team[]
  matches   Match[]
  standings Standing[]
  teamStats TeamStats[]
  playerStatistics PlayerStatistics[]
  teamSeasonStatistics TeamSeasonStatistics[]
  modelPerformance ModelPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId])
}

model Team {
  id          String  @id @default(uuid())
  leagueId    String
  league      League  @relation(fields: [leagueId], references: [id])
  name        String
  shortName   String?
  logoUrl     String?
  externalId  String  @unique
  foundedYear Int?
  contentHash String? @db.VarChar(64)

  players     Player[]
  homeMatches Match[]     @relation("HomeTeam")
  awayMatches Match[]     @relation("AwayTeam")
  teamStats   TeamStats[]
  standings   Standing[]
  playerStatistics PlayerStatistics[]
  teamSeasonStatistics TeamSeasonStatistics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leagueId])
}

model Player {
  id          String    @id @default(uuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  fullName    String
  position    String?
  nationality String?
  dateOfBirth DateTime?
  externalId  String    @unique

  matchEvents MatchEvent[]
  playerStats PlayerStats[]
  playerStatistics PlayerStatistics[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
}

model Match {
  id          String      @id @default(uuid())
  leagueId    String
  league      League      @relation(fields: [leagueId], references: [id])
  homeTeamId  String
  homeTeam    Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String
  awayTeam    Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  matchDate   DateTime
  /// Canonical season of this fixture (for example 2025-2026). A league spans seasons.
  season      String
  status      MatchStatus @default(SCHEDULED)
  homeScore   Int?
  awayScore   Int?
  externalId  String      @unique
  rawData     Json?
  contentHash String?     @db.VarChar(64)

  events      MatchEvent[]
  playerStats PlayerStats[]
  predictions Prediction[]
  eloProcessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchDate])
  @@index([leagueId])
  @@index([leagueId, season])
  @@index([homeTeamId, awayTeamId])
}

model MatchEvent {
  id       String  @id @default(uuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id])
  type     String // goal | card | substitution
  minute   Int
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])
  teamId   String
  detail   Json?

  createdAt DateTime @default(now())

  @@index([matchId])
}

model TeamStats {
  id            String  @id @default(uuid())
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id])
  leagueId      String
  league        League  @relation(fields: [leagueId], references: [id])
  season        String
  matchesPlayed Int     @default(0)
  wins          Int     @default(0)
  draws         Int     @default(0)
  losses        Int     @default(0)
  goalsFor      Int     @default(0)
  goalsAgainst  Int     @default(0)
  eloRating     Decimal @default(1500) @db.Decimal(7, 2)

  updatedAt DateTime @updatedAt

  @@unique([teamId, leagueId, season])
}

model PlayerStats {
  id              String   @id @default(uuid())
  playerId        String
  player          Player   @relation(fields: [playerId], references: [id])
  matchId         String?
  match           Match?   @relation(fields: [matchId], references: [id])
  season          String
  minutesPlayed   Int      @default(0)
  goals           Int      @default(0)
  assists         Int      @default(0)
  rating          Decimal? @db.Decimal(3, 1)
  advancedMetrics Json?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([matchId])
}

model Standing {
  id       String @id @default(uuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id])
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  season   String
  rank     Int
  points   Int
  played   Int
  won      Int
  drawn    Int
  lost     Int

  updatedAt DateTime @updatedAt

  @@unique([leagueId, teamId, season])
}

model SyncJobLog {
  id               String        @id @default(uuid())
  jobName          String
  status           SyncJobStatus
  startedAt        DateTime
  finishedAt       DateTime?
  recordsProcessed Int           @default(0)
  errorMessage     String?

  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
  @@index([status])
  @@index([createdAt])
}

// ===== Prediction Domain (Phase 5) =====

model Prediction {
  id               String            @id @default(uuid())
  matchId          String
  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  modelVersion     String
  homeWinProb      Decimal           @db.Decimal(6, 5)
  drawProb         Decimal?          @db.Decimal(6, 5)
  awayWinProb      Decimal           @db.Decimal(6, 5)
  predictedOutcome PredictionOutcome
  featuresSnapshot Json
  result           PredictionResult?
  views            PredictionView[]
  createdAt        DateTime          @default(now())

  @@unique([matchId, modelVersion])
  @@index([matchId])
}

model PredictionResult {
  id            String            @id @default(uuid())
  predictionId  String            @unique
  prediction    Prediction        @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  actualOutcome PredictionOutcome
  isCorrect     Boolean
  logLoss       Decimal           @db.Decimal(10, 7)
  brierScore    Decimal           @db.Decimal(10, 7)
  evaluatedAt   DateTime          @default(now())

  @@index([predictionId])
}

model ModelPerformance {
  id            String   @id @default(uuid())
  modelVersion  String
  leagueId      String?
  league        League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  periodStart   DateTime
  periodEnd     DateTime
  accuracy      Decimal  @db.Decimal(6, 5)
  precision     Decimal  @db.Decimal(6, 5)
  recall        Decimal  @db.Decimal(6, 5)
  f1            Decimal  @db.Decimal(6, 5)
  avgLogLoss    Decimal  @db.Decimal(10, 7)
  avgBrierScore Decimal  @db.Decimal(10, 7)
  sampleSize    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([modelVersion, leagueId, periodStart, periodEnd])
  @@index([leagueId, periodStart])
  @@index([modelVersion, createdAt])
}

model PredictionView {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  viewedOn     DateTime   @db.Date
  createdAt    DateTime   @default(now())

  @@unique([userId, predictionId, viewedOn])
  @@index([userId, viewedOn])
}

// ===== Billing & Payment Domain (Stripe Integration) =====

enum SubscriptionPlan {
  FREE
  PRO_MONTHLY
  PRO_YEARLY
  VIP_MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String?            @unique
  stripePriceId        String
  plan                 SubscriptionPlan   @default(PRO_MONTHLY)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  receiptUrl            String?
  paymentMethod         String?
  errorMessage          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model WebhookEvent {
  id          String             @id // Stripe Event ID (evt_xxx)
  type        String
  status      WebhookEventStatus @default(RECEIVED)
  payload     Json
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ===== Notification Domain =====

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info") // info | warning | success | system
  isRead    Boolean   @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ===== Audit Log Domain (Security & Compliance) =====

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String // e.g. "USER_STATUS_UPDATED", "ROLE_CHANGED", "SUBSCRIPTION_ACTIVATED"
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

// ===== Season Statistics Domain =====

model PlayerStatistics {
  id            String   @id @default(uuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  playerName    String
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id])
  leagueId      String
  league        League   @relation(fields: [leagueId], references: [id])
  season        String
  sport         String   // "football" | "basketball"

  appearances   Int?     @default(0)
  minutesPlayed Int?     @default(0)

  // Football-specific
  goals         Int?     @default(0)
  assists       Int?     @default(0)
  yellowCards   Int?     @default(0)
  redCards      Int?     @default(0)

  // Basketball-specific (per-game average)
  pointsAvg     Float?
  reboundsAvg   Float?
  assistsAvg    Float?
  stealsAvg     Float?

  contentHash   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([playerId, leagueId, season])
  @@index([leagueId, season, sport])
}

model TeamSeasonStatistics {
  id               String   @id @default(uuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id])
  leagueId         String
  league           League   @relation(fields: [leagueId], references: [id])
  season           String
  sport            String   // "football" | "basketball"

  played           Int      @default(0)
  wins             Int      @default(0)
  draws            Int?     // null cho basketball
  losses           Int      @default(0)

  // Football-specific
  goalsFor         Int?
  goalsAgainst     Int?
  cleanSheets      Int?

  // Basketball-specific
  pointsForAvg     Float?
  pointsAgainstAvg Float?

  contentHash      String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([teamId, leagueId, season])
  @@index([leagueId, season, sport])
}

