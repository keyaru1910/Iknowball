PORT=4000
NODE_ENV=development

# Database (Postgres qua Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iknowball

# Redis (cache, queue)
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email verification
EMAIL_VERIFY_SECRET=replace_with_a_long_random_secret
RESEND_API_KEY=re_your_resend_key
FRONTEND_URL=http://localhost:3000

# Google OAuth (Phase 2 - Auth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Prediction Service (nội bộ, backend gọi sang)
PREDICTION_SERVICE_URL=http://localhost:8000

# Payment (Phase sau - nếu dùng cổng thanh toán VN)
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_SECRET=your_payment_secret
