# ==============================================================================
# iKnowBall Backend Environment Configuration Template
# ==============================================================================
# Lưu ý: Không điền thông tin thực tế hoặc API keys bí mật vào file này.
# Hãy sao chép tệp này sang .env và điền các giá trị thực tế của bạn.

# Cấu hình Cổng & Môi trường
PORT=4000
NODE_ENV=development

# Frontend Origin URL (dùng cho CORS và URL chuyển hướng thanh toán)
FRONTEND_URL=http://localhost:3000

# Cơ sở dữ liệu PostgreSQL (qua Prisma ORM)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iknowball

# Redis (Caching & Job Queues BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Bật khi Redis đang chạy để sử dụng BullMQ cho tiến trình đồng bộ dữ liệu tự động
ENABLE_SYNC_QUEUE=false

# Xác thực người dùng (JWT Tokens)
JWT_SECRET=your_jwt_access_secret_key_here_at_least_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Xác thực Email qua Resend
EMAIL_VERIFY_SECRET=replace_with_a_long_random_secret_for_email_verification
RESEND_API_KEY=re_your_resend_key_here

# Google OAuth2 Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Dịch vụ Dự đoán AI Nội bộ (Python FastAPI Prediction Service)
PREDICTION_SERVICE_URL=http://localhost:8001

# Thể thao & Nhà cung cấp Dữ liệu API (Sports Data Providers)
# provider: api-football (default) hoặc balldontlie (NBA)
SPORTS_PROVIDER=api-football
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here
RAPIDAPI_KEY=your_rapidapi_football_key_here

# Cổng thanh toán Quốc tế Stripe (Subscriptions & Webhook)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_placeholder_id
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_placeholder_id
STRIPE_VIP_MONTHLY_PRICE_ID=price_vip_monthly_placeholder_id

# Cổng thanh toán Phụ / Nội địa (nếu có)
PAYMENT_API_KEY=your_domestic_payment_api_key_here
PAYMENT_SECRET=your_domestic_payment_secret_here
